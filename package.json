{
  "name": "collabhtml",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CollabHTML: a collaboration layer over HTML. Comment threads with pluggable storage and optional HTML export.",
  "main": "src/comments.js",
  "bin": {
    "collabhtml": "scripts/cli.js"
  },
  "files": [
    "src/",
    "ui/",
    "dist/",
    "scripts/",
    "examples/standalone/bootstrap.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "dev": "node examples/viewer/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
