{
  "name": "collabhtml",
  "version": "0.3.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "CollabHTML: a collaboration layer over HTML. Comment threads with pluggable storage and optional HTML export.",
  "main": "./dist/comments.js",
  "types": "./dist/types/src/comments.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/comments.d.ts",
      "import": "./dist/comments.js",
      "default": "./dist/comments.js"
    },
    "./controller": {
      "types": "./dist/types/src/controller.d.ts",
      "import": "./dist/controller.js",
      "default": "./dist/controller.js"
    },
    "./ui": {
      "types": "./dist/types/ui/pane.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./brief": {
      "types": "./dist/types/src/brief.d.ts",
      "import": "./dist/brief.js",
      "default": "./dist/brief.js"
    }
  },
  "bin": {
    "collabhtml": "./dist/cli.cjs"
  },
  "files": [
    "dist/",
    "examples/standalone/bootstrap.js",
    "skills/collabhtml-review/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.types.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "dev": "tsx examples/viewer/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
